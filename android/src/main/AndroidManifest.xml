            "screenSize|smallestScreenSize|screenLayout|orientation"/>

    <application>
        <meta-data
            android:name=
                "com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.ivsplayer.CastOptionsProvider" />
    </application>
</manifest>
